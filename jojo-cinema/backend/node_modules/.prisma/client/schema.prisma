// JoJo Cinema — Prisma Schema
// Database: Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum MovieStatus {
  NOW_SHOWING
  UPCOMING
  ENDED
}

enum SeatType {
  STANDARD
  PREMIUM
  RECLINER
  VIP
}

enum ShowStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ShowSeatStatus {
  AVAILABLE
  LOCKED
  BOOKED
}

enum SeatLockStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONVERTED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  PAYMENT_FAILED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  RECONCILIATION_REQUIRED
}

// ─── Models ────────────────────────────────────────────────────────────────

model Movie {
  id              String      @id @default(uuid())
  title           String
  synopsis        String      @db.Text
  language        String
  genres          String[]
  durationMinutes Int
  certification   String      @default("U/A")
  posterUrl       String?
  backdropUrl     String?
  releaseDate     DateTime
  status          MovieStatus @default(NOW_SHOWING)
  director        String?
  cast            String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  shows Show[]

  @@map("movies")
}

model City {
  id        String   @id @default(uuid())
  name      String   @unique
  state     String
  country   String   @default("India")
  createdAt DateTime @default(now())

  theatres Theatre[]

  @@map("cities")
}

model Theatre {
  id        String   @id @default(uuid())
  name      String
  cityId    String
  address   String
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())

  city    City     @relation(fields: [cityId], references: [id])
  screens Screen[]

  @@map("theatres")
}

model Screen {
  id         String @id @default(uuid())
  theatreId  String
  name       String
  seatLayout Json   @default("{}")

  theatre Theatre @relation(fields: [theatreId], references: [id])
  seats   Seat[]
  shows   Show[]

  @@unique([theatreId, name])
  @@map("screens")
}

model Seat {
  id        String   @id @default(uuid())
  screenId  String
  seatLabel String
  rowLabel  String
  seatType  SeatType @default(STANDARD)
  basePrice Decimal  @db.Decimal(10, 2)

  screen    Screen     @relation(fields: [screenId], references: [id])
  showSeats ShowSeat[]

  @@unique([screenId, seatLabel])
  @@index([screenId, rowLabel])
  @@map("seats")
}

model Show {
  id        String     @id @default(uuid())
  movieId   String
  screenId  String
  startTime DateTime
  endTime   DateTime
  status    ShowStatus @default(SCHEDULED)
  format    String     @default("2D")
  createdAt DateTime   @default(now())

  movie     Movie      @relation(fields: [movieId], references: [id])
  screen    Screen     @relation(fields: [screenId], references: [id])
  showSeats ShowSeat[]
  seatLocks SeatLock[]
  bookings  Booking[]

  @@index([movieId, startTime])
  @@index([screenId, startTime])
  @@map("shows")
}

model ShowSeat {
  id     String         @id @default(uuid())
  showId String
  seatId String
  price  Decimal        @db.Decimal(10, 2)
  status ShowSeatStatus @default(AVAILABLE)

  show          Show           @relation(fields: [showId], references: [id])
  seat          Seat           @relation(fields: [seatId], references: [id])
  seatLockSeats SeatLockSeat[]
  bookingSeats  BookingSeat[]

  @@unique([showId, seatId])
  @@index([showId, status])
  @@map("show_seats")
}

model SeatLock {
  id        String         @id @default(uuid())
  showId    String
  sessionId String
  expiresAt DateTime
  status    SeatLockStatus @default(ACTIVE)
  createdAt DateTime       @default(now())

  show  Show           @relation(fields: [showId], references: [id])
  seats SeatLockSeat[]

  @@index([showId, status, expiresAt])
  @@index([sessionId])
  @@map("seat_locks")
}

model SeatLockSeat {
  id         String @id @default(uuid())
  seatLockId String
  showSeatId String

  seatLock SeatLock @relation(fields: [seatLockId], references: [id])
  showSeat ShowSeat @relation(fields: [showSeatId], references: [id])

  @@unique([seatLockId, showSeatId])
  @@map("seat_lock_seats")
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique
  sessionId        String
  showId           String
  status           BookingStatus @default(PENDING_PAYMENT)
  totalAmount      Decimal       @db.Decimal(10, 2)
  currency         String        @default("INR")
  createdAt        DateTime      @default(now())
  expiresAt        DateTime
  confirmedAt      DateTime?
  cancelledAt      DateTime?

  show         Show          @relation(fields: [showId], references: [id])
  bookingSeats BookingSeat[]
  payments     Payment[]
  ticket       Ticket?

  @@index([sessionId, status])
  @@index([status, expiresAt])
  @@map("bookings")
}

model BookingSeat {
  id             String  @id @default(uuid())
  bookingId      String
  showSeatId     String
  priceAtBooking Decimal @db.Decimal(10, 2)

  booking  Booking  @relation(fields: [bookingId], references: [id])
  showSeat ShowSeat @relation(fields: [showSeatId], references: [id])

  @@unique([bookingId, showSeatId])
  @@unique([showSeatId]) // Prevents double-booking the same show seat
  @@map("booking_seats")
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String
  provider          String        @default("MOCK")
  providerPaymentId String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String        @unique
  providerEventId   String?       @unique // For webhook deduplication
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, status])
  @@map("payments")
}

model Ticket {
  id              String    @id @default(uuid())
  bookingId       String    @unique
  ticketReference String    @unique
  qrToken         String    @unique
  issuedAt        DateTime  @default(now())
  verifiedAt      DateTime?

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("tickets")
}

model TelegramConversation {
  id                 String   @id @default(uuid())
  chatId             String
  userId             String
  messages           Json     @default("[]")
  state              Json     @default("{}")
  processedUpdateIds BigInt[] @default([])
  version            Int      @default(1)
  lastActivityAt     DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([chatId, userId])
  @@index([lastActivityAt])
  @@map("telegram_conversations")
}

model RailStation {
  id        String           @id @default(uuid())
  code      String           @unique
  name      String
  city      String
  state     String
  origins   TrainInventory[] @relation("InventoryOrigin")
  dests     TrainInventory[] @relation("InventoryDestination")
  createdAt DateTime         @default(now())

  @@index([name])
  @@map("rail_stations")
}

model Train {
  id          String           @id @default(uuid())
  number      String           @unique
  name        String
  active      Boolean          @default(true)
  inventories TrainInventory[]
  createdAt   DateTime         @default(now())

  @@map("trains")
}

model TrainInventory {
  id               String         @id @default(uuid())
  trainId          String
  originId         String
  destinationId    String
  journeyDate      DateTime       @db.Date
  departureAt      DateTime
  arrivalAt        DateTime
  classCode        String
  totalSeats       Int
  availableSeats   Int
  farePerPassenger Decimal        @db.Decimal(10, 2)
  updatedAt        DateTime       @updatedAt
  train            Train          @relation(fields: [trainId], references: [id])
  origin           RailStation    @relation("InventoryOrigin", fields: [originId], references: [id])
  destination      RailStation    @relation("InventoryDestination", fields: [destinationId], references: [id])
  bookings         TrainBooking[]

  @@unique([trainId, originId, destinationId, journeyDate, classCode])
  @@index([originId, destinationId, journeyDate])
  @@map("train_inventory")
}

model TrainBooking {
  id             String         @id @default(uuid())
  reference      String         @unique
  idempotencyKey String         @unique
  sessionId      String
  inventoryId    String
  passengerCount Int
  passengers     Json
  totalFare      Decimal        @db.Decimal(10, 2)
  status         String         @default("PENDING_PAYMENT")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  inventory      TrainInventory @relation(fields: [inventoryId], references: [id])
  payment        TrainPayment?

  @@index([sessionId, status])
  @@map("train_bookings")
}

model TrainPayment {
  id        String       @id @default(uuid())
  bookingId String       @unique
  status    String       @default("PENDING")
  outcome   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  booking   TrainBooking @relation(fields: [bookingId], references: [id])

  @@map("train_payments")
}
