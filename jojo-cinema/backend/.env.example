# Environment Variables — JoJo Cinema Backend

# Server
PORT=4000
NODE_ENV=development
DEMO_MODE=true

# Supabase (PostgreSQL via Prisma)
# Get these from your Supabase project → Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# CORS — comma-separated allowed origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Seat lock duration in seconds (default: 5 minutes)
SEAT_LOCK_DURATION_SECONDS=300

# Booking expiry in seconds (default: 15 minutes)
BOOKING_EXPIRY_SECONDS=900

# Max seats per booking
MAX_SEATS_PER_BOOKING=6

# JWT / Session secret (used for demo session tokens)
SESSION_SECRET="change-this-to-a-secure-random-string-in-production"

# For the JoJo WhatsApp Agent system (used in docs)
JOJO_BOOKING_API_BASE_URL="http://localhost:4000/api"

# Optional local Telegram polling adapter. Keep the real token only in backend/.env.
TELEGRAM_BOT_TOKEN=

# Webhook signature secret (mock mode uses this for HMAC verification)
WEBHOOK_SECRET="webhook-secret-change-in-production"

# AI agent foundation. Choose openai or ollama; Ollama runs on this machine.
OPENAI_API_KEY=
AGENT_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
AGENT_MODEL="qwen3.5:4b"
AGENT_TIMEOUT_MS=20000
AGENT_MAX_RETRIES=1
AGENT_MAX_OUTPUT_TOKENS=1000
AGENT_MAX_COST_USD=0.05
AGENT_EVAL_MAX_COST_USD=0.5
# These rates are USD per 1M text tokens. They affect estimates for metered providers;
# set both to 0 for Ollama local inference (electricity is not included).
AGENT_INPUT_COST_PER_1M_USD=0
AGENT_OUTPUT_COST_PER_1M_USD=0
